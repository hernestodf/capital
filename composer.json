{
    "name": "hernestodf/sisloc",
    "description": "ConectaFramework - PHP MVC Framework with RBAC, Agents System",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.0",
        "mpdf/mpdf": "^8.3",
        "phpmailer/phpmailer": "^7.0",
        "phpoffice/phpspreadsheet": "^5.7",
        "setasign/fpdi": "^2.6.7"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "minimum-stability": "stable",
    "scripts": {
        "post-install-cmd": [
            "@prepare-agents"
        ],
        "post-update-cmd": [
            "@prepare-agents"
        ],
        "prepare-agents": "mkdir -p agents ai && cp -r docs/agents/* agents/ && cp -r ai/* ai/ 2>/dev/null || true",
        "test": "phpunit --testdox",
        "test:unit": "phpunit --testsuite Unit --testdox",
        "test:coverage": "phpunit --coverage-text"
    },
    "extra": {
        "agents-dir": "agents"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.2"
    }
}

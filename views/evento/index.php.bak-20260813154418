            $acoesHtml .= '<button type="button" class="btn btn-sm btn-cyan" data-action="converter-evento" data-id="' . $e['id'] . '" title="Converter em Locação">Converter</button> ';
        }
        if (\App\Auth\Rbac::check('eventos.editar')) {
